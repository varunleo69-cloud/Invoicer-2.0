# Copy to .env (never commit .env) and change the password.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invoicer
DB_USER=invoicer
DB_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:8080

# docker-compose.yml only (optional)
# HTTP_PORT=8080

# docker-compose.prod.yml only
# IMAGE_TAG=latest   # in CI this is the commit SHA; set an older SHA to roll back
